{
  "name": "pixel-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm test && tsc --noEmit && vite build",
    "preview": "vite preview",
    "itch": "npm run build && rm -f pixel-game-itch.zip && cd dist && zip -qr ../pixel-game-itch.zip . && echo 'pixel-game-itch.zip ready for itch.io upload'",
    "test": "node --test test/rules.test.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
