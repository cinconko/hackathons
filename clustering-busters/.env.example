# Copy to .env and fill in. Never commit .env.

# Featherless (open-source models). Without these, the backend uses rules only.
FEATHERLESS_API_KEY=
# Pick one model from featherless.ai and paste its exact id here.
FEATHERLESS_MODEL=
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
MODEL_TIMEOUT_S=20

# Optional: use a separate rules file (e.g. for demos) instead of backend/rules.json
RULES_PATH=

# Clusty (Mac app, electron/): screen classifier via the OpenAI Decisions API.
# Without a key the app still runs, decisions stay "unclassified" and nothing leaves the Mac.
# With a key, changed screen frames are sent to OpenAI.
OPENAI_API_KEY=
# Optional overrides
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DECISIONS_MODEL=gpt-6-luna

# Clusty humor mode: the cloud's funny line + voice from Featherless (uses FEATHERLESS_API_KEY above).
# Without the key humor mode still works with canned lines and the macOS voice.
# Optional overrides (defaults measured as the fastest on 2026-11-13):
CLOUD_MODEL=Qwen/Qwen2.5-7B-Instruct
CLOUD_TTS_MODEL=hexgrad/Kokoro-82M
# Kokoro voices: af_heart, af_sky, af_nicole, bf_emma, am_puck
CLOUD_VOICE=af_heart
